# ─────────────────────────────────────────────────────────────
#  BETTING ORACLE — server configuration
# ─────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── Hosting ──────────────────────────────────────────────────
# The API serves the built UI from the same origin, so there is no CORS to
# configure and no client URL to declare.
#
# REQUIRED once the app is reachable by anyone but you: without it, any visitor
# can open Settings and replace your API keys or spend your daily quota.
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# ── MongoDB ──────────────────────────────────────────────────
# This is where your API keys (entered in the app's Settings panel) are stored,
# along with the upstream response cache.
#   Local docker:  npm run mongo:up   (from the repo root)
#   Atlas (free):  mongodb+srv://USER:PASS@CLUSTER.mongodb.net/bettingapp?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/betting

# ── Gemini (free tier — https://aistudio.google.com/apikey) ──
# Put as MANY keys as you want, comma separated. They are rotated
# automatically and a key that hits its quota is benched for a while,
# so N keys ≈ N× the free daily quota.
GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-2.5-flash
# Tried in order if the primary model is overloaded / rate-limited
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000

# ── Sports data ──────────────────────────────────────────────
# espn      — ESPN's public scoreboard: no key, no daily limit, DraftKings odds
#             including live in-play prices. The default; nothing else needed.
# apisports — API-SPORTS (key below). If its key is missing, used up or
#             suspended, the app falls back to ESPN automatically.
# Can also be changed at runtime in the app's Settings panel.
DATA_SOURCE=espn

# TheSportsDB fills in fixtures ESPN doesn't cover (many more football leagues
# live, and far more basketball/hockey). Scores only, no odds. "123" is its
# published free key; a Patreon key raises the limits.
ENABLE_TSDB=true
TSDB_KEY=123

# ── API-SPORTS (only for DATA_SOURCE=apisports — https://dashboard.api-football.com/register)
# One free account = 100 requests/day for EACH of football, basketball, hockey.
# Multiple keys are rotated the same way as the Gemini ones.
SPORTS_API_KEYS=your_api_sports_key
# Set to "rapidapi" if your key comes from RapidAPI instead of api-sports.io
SPORTS_API_PROVIDER=apisports

# ── Behaviour ────────────────────────────────────────────────
TIMEZONE=Europe/Paris
# Fetch bookmaker odds to anchor the model (costs 1 API call per game,
# only on demand when a prediction is requested). Highly recommended.
ENABLE_ODDS=true
# How much weight the bookmaker market gets vs. the statistical model (0..1)
MARKET_WEIGHT=0.55
# Cache lifetimes (seconds)
CACHE_TTL_LIVE=45
CACHE_TTL_FIXTURES=900
CACHE_TTL_STATS=43200
CACHE_TTL_ODDS=1800
CACHE_TTL_PREDICTION=1800
